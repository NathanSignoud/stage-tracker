# Aucun script d'installation des dépendances : better-sqlite3 embarque ses binaires précompilés (prebuilds/),
# mais npm, en installant depuis package-lock.json, tenterait de le recompiler (Visual Studio requis sous Windows).
# Les autres (esbuild, unrs-resolver) trouvent leur binaire sans script. `npm run …` n'est pas concerné.
ignore-scripts=true

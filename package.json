{
  "name": "stage-tracker",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/startup.ts && next dev -H 127.0.0.1",
    "dev:lan": "tsx scripts/startup.ts && tsx scripts/dev-lan.ts",
    "mobile": "tsx scripts/startup.ts && tsx scripts/mobile.mts",
    "build": "next build",
    "start": "tsx scripts/startup.ts && next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "diff": "9.0.0",
    "docx": "9.13.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "mammoth": "1.13.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "node-html-parser": "9.0.5",
    "pdf-lib": "1.17.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
